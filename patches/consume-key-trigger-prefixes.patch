+func TestKeyboardTriggerConsumesJoyConPrefix(t *testing.T) {
+	app := newKeyboardPrefixTestApp(Rule{
+		Enabled: true,
+		Input: []Item{
+			{Kind: "JoyCon", Code: "ZL"},
