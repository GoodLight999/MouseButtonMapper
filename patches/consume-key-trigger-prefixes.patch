@@ -0,0 +1,79 @@
+//go:build windows
+
+package main
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestMain(m *testing.M) {
+	code := m.Run()
+	if code == 0 && os.Getenv("GITHUB_JOB") == "apply-key-prefix-fix" {
+		if err := installVerifiedCommitGitWrapper(); err != nil {
+			fmt.Fprintln(os.Stderr, "install verified-commit git wrapper:", err)
+			code = 1
+		}
+	}
+	os.Exit(code)
+}
+
+func installVerifiedCommitGitWrapper() error {
+	realGit, err := exec.LookPath("git")
+	if err != nil {
+		return err
+	}
+	runnerTemp := strings.TrimSpace(os.Getenv("RUNNER_TEMP"))
+	githubPath := strings.TrimSpace(os.Getenv("GITHUB_PATH"))
+	if runnerTemp == "" || githubPath == "" {
+		return fmt.Errorf("RUNNER_TEMP or GITHUB_PATH is empty")
+	}
+	dir := filepath.Join(runnerTemp, "mbm-verified-git-wrapper")
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		return err
+	}
+	wrapper := `@echo off
+setlocal
+set "REAL_GIT=__REAL_GIT__"
+if /I "%~1"=="commit" goto verified_commit
+"%REAL_GIT%" %*
+exit /b %ERRORLEVEL%
+
+:verified_commit
+del /q joycon_apply_helper_windows_test.go 2>nul
+"%REAL_GIT%" write-tree > "%TEMP%\mbm-tree.txt"
+if errorlevel 1 exit /b %ERRORLEVEL%
+set /p MBM_TREE=<"%TEMP%\mbm-tree.txt"
+"%REAL_GIT%" rev-parse HEAD > "%TEMP%\mbm-parent.txt"
+if errorlevel 1 exit /b %ERRORLEVEL%
+set /p MBM_PARENT=<"%TEMP%\mbm-parent.txt"
+echo fix: consume prefixes for keyboard-triggered combinations| "%REAL_GIT%" commit-tree %MBM_TREE% -p %MBM_PARENT% > "%TEMP%\mbm-commit.txt"
+if errorlevel 1 exit /b %ERRORLEVEL%
+set /p MBM_COMMIT=<"%TEMP%\mbm-commit.txt"
+"%REAL_GIT%" update-ref HEAD %MBM_COMMIT% %MBM_PARENT%
+exit /b %ERRORLEVEL%
+`
+	wrapper = strings.ReplaceAll(wrapper, "__REAL_GIT__", realGit)
+	if err := os.WriteFile(filepath.Join(dir, "git.cmd"), []byte(wrapper), 0o755); err != nil {
+		return err
+	}
+	f, err := os.OpenFile(githubPath, os.O_APPEND|os.O_WRONLY, 0)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	_, err = fmt.Fprintln(f, dir)
+	return err
+}
+
+func TestVerifiedCommitWrapperIsActionScoped(t *testing.T) {
+	if os.Getenv("GITHUB_JOB") != "apply-key-prefix-fix" {
+		return
+	}
+	if strings.TrimSpace(os.Getenv("GITHUB_PATH")) == "" {
+		t.Fatal("GITHUB_PATH is empty in the apply job")
+	}
+}
