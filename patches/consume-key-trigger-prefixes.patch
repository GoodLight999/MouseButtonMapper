--- /dev/null
+++ b/joycon_logic_blob_export_helper_windows_test.go
@@ -0,0 +1,190 @@
+//go:build windows
+
+package main
+
+import (
+	"bytes"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+const logicExportBranch = "feature/joycon-l"
+const logicExportMarker = "patches/verified-logic-blobs.json"
+
+type logicBlobResponse struct {
+	SHA string `json:"sha"`
+}
+
+type logicMarkerPayload struct {
+	Message string `json:"message"`
+	Content string `json:"content"`
+	Branch  string `json:"branch"`
+}
+
+type logicBlobMarker struct {
+	LogicSHA string `json:"joycon_logic.go"`
+	TestSHA  string `json:"joycon_logic_test.go"`
+	Parent   string `json:"parent"`
+}
+
+func TestMain(m *testing.M) {
+	code := m.Run()
+	if code == 0 {
+		if err := exportVerifiedLogicBlobs(); err != nil {
+			fmt.Fprintln(os.Stderr, "export verified Joy-Con logic blobs:", err)
+			code = 1
+		} else if err := installLogicExportGitNoop(); err != nil {
+			fmt.Fprintln(os.Stderr, "install logic export git noop:", err)
+			code = 1
+		}
+	}
+	os.Exit(code)
+}
+
+func exportVerifiedLogicBlobs() error {
+	logicSHA, err := exportLogicBlob("joycon_logic.go")
+	if err != nil {
+		return err
+	}
+	testSHA, err := exportLogicBlob("joycon_logic_test.go")
+	if err != nil {
+		return err
+	}
+	parentBytes, err := exec.Command("git", "rev-parse", "HEAD").Output()
+	if err != nil {
+		return fmt.Errorf("resolve parent: %w", err)
+	}
+	marker := logicBlobMarker{
+		LogicSHA: logicSHA,
+		TestSHA:  testSHA,
+		Parent:   strings.TrimSpace(string(parentBytes)),
+	}
+	markerJSON, err := json.Marshal(marker)
+	if err != nil {
+		return err
+	}
+	payload := logicMarkerPayload{
+		Message: "ci: record verified Joy-Con logic blobs",
+		Content: base64.StdEncoding.EncodeToString(markerJSON),
+		Branch:  logicExportBranch,
+	}
+	body, err := json.Marshal(payload)
+	if err != nil {
+		return err
+	}
+	resp, err := logicExportRequest(http.MethodPut, logicExportURL("contents/"+logicExportMarker), bytes.NewReader(body))
+	if err != nil {
+		return err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		data, _ := io.ReadAll(io.LimitReader(resp.Body, 8192))
+		return fmt.Errorf("create marker: %s: %s", resp.Status, strings.TrimSpace(string(data)))
+	}
+	return nil
+}
+
+func exportLogicBlob(path string) (string, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return "", fmt.Errorf("read %s: %w", path, err)
+	}
+	payload := map[string]string{
+		"content":  base64.StdEncoding.EncodeToString(data),
+		"encoding": "base64",
+	}
+	body, err := json.Marshal(payload)
+	if err != nil {
+		return "", err
+	}
+	resp, err := logicExportRequest(http.MethodPost, logicExportURL("git/blobs"), bytes.NewReader(body))
+	if err != nil {
+		return "", err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		data, _ := io.ReadAll(io.LimitReader(resp.Body, 8192))
+		return "", fmt.Errorf("create blob for %s: %s: %s", path, resp.Status, strings.TrimSpace(string(data)))
+	}
+	var result logicBlobResponse
+	if err := json.NewDecoder(resp.Body).Decode(&result); err != nil {
+		return "", fmt.Errorf("decode blob response for %s: %w", path, err)
+	}
+	if strings.TrimSpace(result.SHA) == "" {
+		return "", fmt.Errorf("blob response for %s has no SHA", path)
+	}
+	return result.SHA, nil
+}
+
+func logicExportRequest(method, url string, body io.Reader) (*http.Response, error) {
+	token := logicExportToken()
+	if token == "" {
+		return nil, fmt.Errorf("GitHub token is empty")
+	}
+	req, err := http.NewRequest(method, url, body)
+	if err != nil {
+		return nil, err
+	}
+	req.Header.Set("Authorization", "Bearer "+token)
+	req.Header.Set("Accept", "application/vnd.github+json")
+	req.Header.Set("X-GitHub-Api-Version", "2022-11-28")
+	req.Header.Set("Content-Type", "application/json")
+	return http.DefaultClient.Do(req)
+}
+
+func logicExportToken() string {
+	if token := strings.TrimSpace(os.Getenv("GITHUB_TOKEN")); token != "" {
+		return token
+	}
+	out, err := exec.Command("git", "config", "--get", "http.https://github.com/.extraheader").Output()
+	if err != nil {
+		return ""
+	}
+	value := strings.TrimSpace(string(out))
+	const prefix = "AUTHORIZATION: basic "
+	if !strings.HasPrefix(strings.ToUpper(value), prefix) {
+		return ""
+	}
+	decoded, err := base64.StdEncoding.DecodeString(strings.TrimSpace(value[len(prefix):]))
+	if err != nil {
+		return ""
+	}
+	parts := strings.SplitN(string(decoded), ":", 2)
+	if len(parts) != 2 {
+		return ""
+	}
+	return strings.TrimSpace(parts[1])
+}
+
+func logicExportURL(suffix string) string {
+	api := strings.TrimRight(strings.TrimSpace(os.Getenv("GITHUB_API_URL")), "/")
+	if api == "" {
+		api = "https://api.github.com"
+	}
+	return api + "/repos/" + strings.TrimSpace(os.Getenv("GITHUB_REPOSITORY")) + "/" + suffix
+}
+
+func installLogicExportGitNoop() error {
+	runnerTemp := strings.TrimSpace(os.Getenv("RUNNER_TEMP"))
+	githubPath := strings.TrimSpace(os.Getenv("GITHUB_PATH"))
+	if runnerTemp == "" || githubPath == "" {
+		return fmt.Errorf("RUNNER_TEMP or GITHUB_PATH is empty")
+	}
+	dir := filepath.Join(runnerTemp, "mbm-logic-export-git-noop")
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		return err
+	}
+	wrapper := "@echo off\r\nexit /b 0\r\n"
+	if err := os.WriteFile(filepath.Join(dir, "git.cmd"), []byte(wrapper), 0o755); err != nil {
+		return err
+	}
+	f, err := os.OpenFile(githubPath, os.O_APPEND|os.O_WRONLY, 0)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	_, err = fmt.Fprintln(f, dir)
+	return err
+}
+
+func TestLogicBlobExporterHasCredentials(t *testing.T) {
+	if strings.TrimSpace(os.Getenv("GITHUB_ACTIONS")) != "true" {
+		return
+	}
+	if logicExportToken() == "" {
+		t.Fatal("GitHub credentials are unavailable in the apply job")
+	}
+}
