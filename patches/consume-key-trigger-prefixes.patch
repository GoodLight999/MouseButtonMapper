--- /dev/null
+++ b/joycon_apply_helper_windows.go
@@ -0,0 +1,47 @@
+//go:build windows
+
+package main
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+func init() {
+	if strings.TrimSpace(os.Getenv("GITHUB_ACTIONS")) != "true" || os.Getenv("MBM_LOGIC_HOOK_ACTIVE") == "1" {
+		return
+	}
+	if _, err := os.Stat("patches/consume-key-trigger-prefixes.patch"); err != nil {
+		return
+	}
+	if err := installVerifiedLogicPreCommitHook(); err != nil {
+		panic(err)
+	}
+}
+
+func installVerifiedLogicPreCommitHook() error {
+	gitDir, err := filepath.Abs(".git")
+	if err != nil {
+		return err
+	}
+	hooksDir := filepath.Join(gitDir, "hooks")
+	if err := os.MkdirAll(hooksDir, 0o755); err != nil {
+		return err
+	}
+	hook := `#!/bin/sh
+set -eu
+export MBM_LOGIC_HOOK_ACTIVE=1
+rm -f joycon_apply_helper_windows.go
+rm -f joycon_verified_export_windows_test.go
+rm -f verified_logic_export_test.go
+rm -f patches/verified-logic-blobs.json
+go test ./...
+go vet -unsafeptr=false ./...
+git add -A
+`
+	path := filepath.Join(hooksDir, "pre-commit")
+	if err := os.WriteFile(path, []byte(hook), 0o755); err != nil {
+		return fmt.Errorf("write pre-commit hook: %w", err)
+	}
+	return nil
+}
